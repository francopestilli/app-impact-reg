#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.

set -e

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

# --nv is a no-op when no NVIDIA driver is present, so the same container
# runs GPU-accelerated or CPU-only registration (see the require_cuda config
# option to fail instead of silently falling back to CPU). main.py always
# runs under venv-default's python (SimpleITK/ngff-zarr for the transform
# conversion) regardless of which venv the registration subprocess itself
# uses -- see main.py's own docstring.
singularity exec -e --nv docker://gamorosino/app-impact-reg:0.1 /opt/venv-default/bin/python3 main.py

[ -z "$(ls -A warp 2>/dev/null)" ] && echo "no output produced" && exit 1
exit 0
